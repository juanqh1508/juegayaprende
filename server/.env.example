# Puerto del servidor backend
PORT=5000

# Clave secreta para firmar los JSON Web Tokens (cámbiala en producción por una cadena larga y segura)
JWT_SECRET=super_secreto_cambiar_en_produccion_12345!

# Configuración de conexión a PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=tu_contraseña_aqui
PGDATABASE=plataforma_juegos

# Identificadores de clientes OAuth para Google y Microsoft (Opcionales para inicio con botones sociales)
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
